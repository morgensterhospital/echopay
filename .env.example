# EchoPay Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# FIREBASE CLIENT CONFIGURATION (Required)
# ============================================================================
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=AIza...your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ============================================================================
# FIREBASE ADMIN SDK (Required for Netlify Functions)
# ============================================================================
# Get these from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# ============================================================================
# GOOGLE GEMINI AI (Optional - app works with mocks if not provided)
# ============================================================================
# Get from Google Cloud Console > APIs & Services > Credentials
GEMINI_API_KEY=AIza...your_gemini_api_key_here
VITE_GEMINI_API_KEY=AIza...your_gemini_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Set to 'true' for development, 'false' for production with real payments
MOCK_MODE=true
VITE_MOCK_MODE=true

# Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# PAYMENT GATEWAY CREDENTIALS (For Production - Leave empty for mock mode)
# ============================================================================
# Paynow (Zimbabwe)
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key

# Stripe (International)
STRIPE_SECRET_KEY=sk_test_...your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_...your_stripe_publishable_key

# EcoCash API (Zimbabwe)
ECOCASH_API_KEY=your_ecocash_api_key
ECOCASH_MERCHANT_ID=your_ecocash_merchant_id

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================
# Sentry for error tracking (optional)
VITE_SENTRY_DSN=https://...your_sentry_dsn

# Google Analytics (optional)
VITE_GA_TRACKING_ID=G-...your_ga_tracking_id

# Netlify Site ID (for deployment)
NETLIFY_SITE_ID=your-netlify-site-id